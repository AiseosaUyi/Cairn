# React Native / Metro cannot resolve pnpm's default symlinked node_modules.
# A hoisted layout makes pnpm behave like npm/bun for RN while keeping pnpm's
# speed and disk savings. Required for Expo + pnpm. Harmless for npm/bun.
node-linker=hoisted
shamefully-hoist=true

# Keep Expo's own peer-dep expectations from failing installs.
strict-peer-dependencies=false
