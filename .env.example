# Copy to .env. The app runs WITHOUT these (mock LLM + local SQLite store).
# Add real values to switch from mock to live adapters.

# LLM provider: "mock" (default, no key needed) | "anthropic" | "openai"
EXPO_PUBLIC_LLM_PROVIDER=mock
EXPO_PUBLIC_LLM_API_KEY=
EXPO_PUBLIC_LLM_MODEL=claude-opus-4-7

# Data layer: "local" (default, expo-sqlite) | "supabase"
EXPO_PUBLIC_DATA_ADAPTER=local
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Safety gates. Stay false until external review clears them (see CEO plan).
# Flipping these true without sign-off violates the approved plan.
EXPO_PUBLIC_GATE_CRISIS_REVIEWED=false
EXPO_PUBLIC_GATE_HEALTH_CLEARED=false
